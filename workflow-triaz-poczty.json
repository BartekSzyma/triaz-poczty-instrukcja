    {
      "parameters": {
        "jsCode": "// Discord pokazuje markdown, więc usuwamy znaki, którymi obcy mail mógłby podrobić link, wzmiankę albo formatowanie.\nconst czysc = (s, max) => String(s ?? '').replace(/[\\[\\]()<>*_~`|@#]/g, ' ').slice(0, max);\nconst ETYKIETA = { pilne: '🔴 PILNE', do_odpowiedzi: '🟡 Do odpowiedzi' };\n\nreturn $input.all().map((item) => {\n  const m = item.json;\n  const fragment = czysc(m.fragment, 700).trim();\n  const tresc = '**📬 ' + (ETYKIETA[m.kategoria] ?? m.kategoria) + '**\\n' +\n    '**Od:** ' + czysc(m.nadawca, 200) + '\\n' +\n    '**Temat:** ' + czysc(m.temat, 200) + '\\n\\n' +\n    '**Treść maila (początek):**\\n' + (fragment || '(pusta)') + (String(m.fragment ?? '').length > 700 ? ' …' : '') + '\\n\\n' +\n    '**Proponowana odpowiedź:**\\n' + czysc(m.szkic, 1500);\n  const wiadomosc = tresc + '\\n\\nKliknij **Odpowiedz**, popraw tekst w formularzu i wybierz: Wyślij, Zapisz jako szkic albo Odrzuć.';\n  // Formularz n8n nie zna markdownu, więc dostaje ten sam tekst bez gwiazdek.\n  const opis_formularza = tresc.replace(/\\*\\*/g, '') + '\\n\\nPopraw odpowiedź poniżej i wybierz decyzję.';\n  return { json: { ...m, wiadomosc, opis_formularza } };\n});"
      },
