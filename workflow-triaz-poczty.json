    {
      "parameters": {
        "jsCode": "// Podsumowanie decyzji. Zostaje na kanale pod propozycją, więc kanał jest historią wszystkich maili.\nconst czysc = (s, max) => String(s ?? '').replace(/[\\[\\]()<>*_~`|@#]/g, ' ').slice(0, max);\nconst mail = $('Wiadomość do Discorda').first().json;\nconst odp = $('Discord: akceptacja').first().json.data ?? {};\nconst tekst = String(odp['Odpowiedź'] ?? '').trim();\n\nlet status;\nif (odp.Decyzja === 'Wyślij' && tekst) status = '✅ **Wysłano odpowiedź**';\nelse if (odp.Decyzja === 'Odrzuć') status = '🗑️ **Odrzucono**: nic nie wysłano, szkicu nie zapisano';\nelse if (odp.Decyzja) status = '📝 **Zapisano szkic w Gmailu** (Wersje robocze)';\nelse status = '⏰ **Brak decyzji przez 24 h**: zapisano szkic w Gmailu (Wersje robocze)';\n\nlet wiadomosc = status + '\\nOd: ' + czysc(mail.nadawca, 200) + '\\nTemat: ' + czysc(mail.temat, 200);\nif (status.startsWith('✅')) wiadomosc += '\\n\\n' + czysc(tekst, 1500);\nreturn [{ json: { wiadomosc } }];"
      },
