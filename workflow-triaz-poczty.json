    {
      "parameters": {
        "jsCode": "// Wyciąga kategorię i szkic z odpowiedzi Claude Code (--output-format json).\nreturn $input.all().map((item, i) => {\n  const mail = $('Przygotuj maila').itemMatching(i).json;\n  let wynik;\n  try {\n    const out = JSON.parse(item.json.stdout);\n    wynik = out.structured_output ?? JSON.parse(out.result);\n  } catch (e) {\n    wynik = { kategoria: 'inne', szkic_odpowiedzi: '', blad: String(item.json.stderr || e.message) };\n  }\n  return {\n    json: {\n      id: mail.id,\n      threadId: mail.threadId,\n      nadawca: mail.nadawca,\n      temat: mail.temat,\n      fragment: mail.fragment,\n      kategoria: wynik.kategoria,\n      szkic: wynik.szkic_odpowiedzi ?? '',\n      blad: wynik.blad ?? null\n    }\n  };\n});"
      },
